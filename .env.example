# =============================================================================
# LA DERNIÈRE TROMPETTE — VARIABLES D'ENVIRONNEMENT
#
# Copiez ce fichier vers `.env` puis renseignez les valeurs.
# `.env` est ignoré par Git : aucun secret ne doit jamais être versionné.
# =============================================================================

# --- OBLIGATOIRE -------------------------------------------------------------

# Connexion PostgreSQL.
# Local   : postgresql://postgres:motdepasse@localhost:5432/laderniere_trompette?schema=public
# Neon    : copiez la chaîne "Pooled connection" depuis le tableau de bord Neon.
DATABASE_URL="postgresql://user:password@localhost:5432/laderniere_trompette?schema=public"

# Clé de signature des sessions administrateur. 32 caractères minimum.
# Générez-la avec :  openssl rand -base64 48
# Changer cette valeur déconnecte immédiatement tous les administrateurs.
SESSION_SECRET=""

# --- RECOMMANDÉ --------------------------------------------------------------

# URL publique canonique du site, sans slash final.
# Utilisée par le sitemap, les balises Open Graph et les données structurées.
# Sur Vercel, déduite automatiquement si absente.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- STOCKAGE DES IMAGES (optionnel en local, OBLIGATOIRE en production) ------
#
# Sans ces clés, les images sont écrites dans public/uploads : pratique en
# développement, INOPÉRANT en production où le disque est en lecture seule.
# Compte gratuit : https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- NOTIFICATIONS PAR EMAIL (optionnel) -------------------------------------
#
# Sans ces clés, aucun email n'est envoyé. Les commandes et les messages
# restent consultables dans l'espace d'administration : rien n'est perdu.
# Compte gratuit : https://resend.com
RESEND_API_KEY=""
# Expéditeur : le domaine doit être vérifié chez Resend.
EMAIL_FROM="La Dernière Trompette <contact@votre-domaine.com>"
# Destinataire des notifications de commande et de contact.
NOTIFY_EMAIL=""

# --- COMPTE ADMINISTRATEUR INITIAL (utilisé une seule fois par le seed) -------
#
# Lus par `npm run db:seed` pour créer le premier compte.
# Supprimez-les ou laissez-les vides une fois le compte créé.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrateur"
