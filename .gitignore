# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files : les secrets ne sont JAMAIS versionnes.
# .env.example est volontairement conserve comme modele.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Ajouts du projet -------------------------------------------------------

# Client Prisma généré : reconstruit par `prisma generate` (postinstall).
/src/generated

# Images envoyées depuis l'administration en développement local.
# En production, elles partent sur Cloudinary et ne touchent jamais le dépôt.
/public/uploads/*
!/public/uploads/.gitkeep
